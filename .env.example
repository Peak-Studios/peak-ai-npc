AI_NPC_GATEWAY_SECRET=replace-with-a-long-random-secret
# Managed SaaS deployments validate per-install credentials against Peak's
# customer portal. This secret is gateway-to-portal only and never ships in the
# FiveM resource. Spendable entitlement/quota responses are never cached.
AI_NPC_ENTITLEMENT_URL=
AI_NPC_GATEWAY_PORTAL_SECRET=
AI_NPC_ENTITLEMENT_TIMEOUT_MS=3000
# Optional explicit override. Otherwise usage is posted to
# <AI_NPC_PORTAL_BASE_URL>/api/gateway/usage or derived from the entitlement URL.
AI_NPC_PORTAL_BASE_URL=
AI_NPC_USAGE_URL=
AI_NPC_USAGE_TIMEOUT_MS=1500
# Optional heartbeat override; otherwise derived from the portal/entitlement URL.
AI_NPC_HEARTBEAT_URL=
AI_NPC_HEARTBEAT_TIMEOUT_MS=1500
# Use loopback when FXServer and players test on this computer. Remote players
# need a client-reachable HTTPS URL instead.
AI_NPC_PUBLIC_BASE_URL=http://127.0.0.1:8787
# Loopback audio is accepted only with this explicit local-development switch.
# Set false in every staged/production deployment and use client-reachable HTTPS.
AI_NPC_LOCAL_DEVELOPMENT=true
POSTGRES_PASSWORD=replace-with-a-database-password
# Direct/non-Compose deployments set the same persistent gateway database here.
AI_NPC_DATABASE_URL=
# Private durable paid-operation replay state. Persist the data directory; one
# gateway process owns these files. Never share writable files across replicas.
AI_NPC_OPERATIONS_FILE=./data/operations.json
AI_NPC_DIRECT_OPERATIONS_FILE=./data/direct-operations.json
AI_NPC_PROVIDER_CONCURRENCY=8
AI_NPC_REQUEST_TIMEOUT_MS=30000
AI_NPC_PROVIDER_TIMEOUT_MS=20000

# Optional text provider configuration.  Use `openai-compatible` for any
# OpenAI Chat Completions-compatible gateway (OpenRouter, Groq, Together,
# Mistral, vLLM, llama.cpp, LiteLLM, etc.).  Use `ollama` for a local Ollama
# server; its key is normally blank. Native Anthropic and Gemini APIs are also
# supported. Custom provider adapters implement gateway/src/providers/types.ts.
AI_NPC_PROVIDER=mock
AI_NPC_PROVIDER_KEY=
AI_NPC_PROVIDER_ENDPOINT=https://api.openai.com/v1
AI_NPC_PROVIDER_MODEL=gpt-4o-mini
# Optional for reasoning-capable OpenAI-compatible models. Leave blank unless
# the selected provider documents these exact values.
AI_NPC_PROVIDER_REASONING_EFFORT=
AI_NPC_PROVIDER_REASONING_FORMAT=
AI_NPC_PROVIDER_MAX_OUTPUT_TOKENS=180
# Keep replies short for game dialogue and align this with strict TTS limits.
AI_NPC_MAX_RESPONSE_CHARACTERS=1200
# Dashboard conversation rows contain metadata only by default. Enabling this
# stores bounded input/output text in process memory until the gateway restarts.
AI_NPC_ADMIN_STORE_TRANSCRIPTS=false
# Set to `off` for text-only models that do not implement function calling.
AI_NPC_PROVIDER_TOOL_MODE=auto
AI_NPC_PROVIDER_RETRIES=0
AI_NPC_PROVIDER_RETRY_DELAY_MS=150
# Asynchronous structured-memory extraction; dialogue never waits for this queue.
AI_NPC_MEMORY_CONCURRENCY=4
AI_NPC_MEMORY_QUEUE_MAX=500
# Optional independent failover provider. Leave unset to surface primary
# failures directly; production never silently falls back to mock dialogue.
AI_NPC_FALLBACK_PROVIDER=
AI_NPC_FALLBACK_KEY=
AI_NPC_FALLBACK_ENDPOINT=
AI_NPC_FALLBACK_MODEL=
AI_NPC_FALLBACK_REASONING_EFFORT=
AI_NPC_FALLBACK_REASONING_FORMAT=
AI_NPC_FALLBACK_MAX_OUTPUT_TOKENS=180
AI_NPC_TTS_PROVIDER=elevenlabs
# ElevenLabs API key when the provider above is `elevenlabs`.
AI_NPC_TTS_KEY=
AI_NPC_TTS_ENDPOINT=
AI_NPC_TTS_MODEL=eleven_flash_v2_5
# Provider-native IDs live only in the ignored registry populated by
# `npm run voices:provision -- --server <id>`.
AI_NPC_TTS_VOICE=
AI_NPC_TTS_FORMAT=mp3_44100_128
AI_NPC_TTS_MAX_CHARACTERS=1200
AI_NPC_TTS_DEFAULT_PROFILE=martin-hale
AI_NPC_VOICE_REGISTRY_PATH=./data/voice-registry.json
AI_NPC_VOICE_PROFILES_PATH=./voice-profiles.example.json
# Safety cap for explicit Voice Design account mutations. The shipped manifest
# contains 27 profiles (2 story-only profile IDs plus ambient pool voices).
# Story-only means excluded from ambient pools; it does not claim a custom or
# globally exclusive provider voice.
AI_NPC_VOICE_PROVISION_MAX=32
# Used only by the native Cartesia adapter.
AI_NPC_CARTESIA_VERSION=2026-03-01
AI_NPC_VISION_PROVIDER=
AI_NPC_VISION_KEY=
AI_NPC_VISION_ENDPOINT=
AI_NPC_VISION_MODEL=
AI_NPC_VISION_TIMEOUT_MS=8000
AI_NPC_VISION_MAX_OUTPUT_TOKENS=120
AI_NPC_VISION_REASONING_EFFORT=
AI_NPC_VISION_REASONING_FORMAT=
AI_NPC_VISION_KEEP_ALIVE=30m
# Optional independent provider used only after a transient timeout, transport
# failure, 408/425/429, or 5xx response. Auth and request errors never fail over.
AI_NPC_VISION_FALLBACK_PROVIDER=
AI_NPC_VISION_FALLBACK_KEY=
AI_NPC_VISION_FALLBACK_ENDPOINT=
AI_NPC_VISION_FALLBACK_MODEL=
AI_NPC_VISION_FALLBACK_TIMEOUT_MS=8000
AI_NPC_VISION_FALLBACK_MAX_OUTPUT_TOKENS=120
AI_NPC_VISION_FALLBACK_REASONING_EFFORT=
AI_NPC_VISION_FALLBACK_REASONING_FORMAT=
AI_NPC_VISION_FALLBACK_KEEP_ALIVE=30m
AI_NPC_STT_PROVIDER=
AI_NPC_STT_KEY=
AI_NPC_STT_ENDPOINT=
AI_NPC_STT_MODEL=
