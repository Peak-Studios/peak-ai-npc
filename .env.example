# ============================================================
# Peak AI NPC — Gateway Configuration
# Copy this file to gateway/.env and fill in your values.
# ============================================================

# -----------------------------------------------------------
# Required: Shared secret between FiveM resource and gateway
# Must match peak_ai_npc_gateway_secret in server.cfg
# -----------------------------------------------------------
AI_NPC_GATEWAY_SECRET=replace-with-a-long-random-secret

# URL that player clients connect to for audio playback.
# Use loopback for local development; use HTTPS for production.
AI_NPC_PUBLIC_BASE_URL=http://127.0.0.1:8787
# Set to false in production to enforce HTTPS on the public URL.
AI_NPC_LOCAL_DEVELOPMENT=true

# -----------------------------------------------------------
# Database (optional — file-backed memory is used without it)
# -----------------------------------------------------------
POSTGRES_PASSWORD=replace-with-a-database-password
# Direct/non-Compose deployments: set the full connection string.
AI_NPC_DATABASE_URL=

# -----------------------------------------------------------
# Gateway performance
# -----------------------------------------------------------
AI_NPC_PROVIDER_CONCURRENCY=8
AI_NPC_REQUEST_TIMEOUT_MS=30000
AI_NPC_PROVIDER_TIMEOUT_MS=20000
AI_NPC_OPERATIONS_FILE=./data/operations.json

# -----------------------------------------------------------
# Text (LLM) provider
# Use `openai-compatible` for Groq, OpenRouter, Together,
# Mistral, vLLM, llama.cpp, LiteLLM, etc.
# Use `ollama` for a local Ollama server (key is blank).
# Use `anthropic` or `gemini` for those native APIs.
# Use `mock` to run without any API keys (stub responses).
# -----------------------------------------------------------
AI_NPC_PROVIDER=mock
AI_NPC_PROVIDER_KEY=
AI_NPC_PROVIDER_ENDPOINT=https://api.openai.com/v1
AI_NPC_PROVIDER_MODEL=gpt-4o-mini
AI_NPC_PROVIDER_REASONING_EFFORT=
AI_NPC_PROVIDER_REASONING_FORMAT=
AI_NPC_PROVIDER_MAX_OUTPUT_TOKENS=180
# Keep replies short for game dialogue.
AI_NPC_MAX_RESPONSE_CHARACTERS=1200
# Dashboard conversation rows contain metadata only by default.
# Enable to store bounded input/output text in process memory.
AI_NPC_ADMIN_STORE_TRANSCRIPTS=false
# Set to `off` for text-only models that don't support function calling.
AI_NPC_PROVIDER_TOOL_MODE=auto
AI_NPC_PROVIDER_RETRIES=0
AI_NPC_PROVIDER_RETRY_DELAY_MS=150
# Async memory extraction — dialogue never waits for this queue.
AI_NPC_MEMORY_CONCURRENCY=4
AI_NPC_MEMORY_QUEUE_MAX=500

# Optional independent failover provider.
AI_NPC_FALLBACK_PROVIDER=
AI_NPC_FALLBACK_KEY=
AI_NPC_FALLBACK_ENDPOINT=
AI_NPC_FALLBACK_MODEL=
AI_NPC_FALLBACK_REASONING_EFFORT=
AI_NPC_FALLBACK_REASONING_FORMAT=
AI_NPC_FALLBACK_MAX_OUTPUT_TOKENS=180

# -----------------------------------------------------------
# TTS (Voice) provider — optional
# Leave blank to use text/subtitle fallback only.
# -----------------------------------------------------------
AI_NPC_TTS_PROVIDER=elevenlabs
AI_NPC_TTS_KEY=
AI_NPC_TTS_ENDPOINT=
AI_NPC_TTS_MODEL=eleven_flash_v2_5
AI_NPC_TTS_FORMAT=mp3_44100_128
AI_NPC_TTS_MAX_CHARACTERS=1200
AI_NPC_TTS_DEFAULT_PROFILE=martin-hale
AI_NPC_VOICE_REGISTRY_PATH=./data/voice-registry.json
AI_NPC_VOICE_PROFILES_PATH=./voice-profiles.example.json
# Max voice profiles that can be provisioned via `npm run voices:provision`.
AI_NPC_VOICE_PROVISION_MAX=32
# Used only by the native Cartesia adapter.
AI_NPC_CARTESIA_VERSION=2026-03-01

# -----------------------------------------------------------
# Vision provider — optional, disabled by default
# Enable per-server with setr peak_ai_npc_vision_enabled 1
# Review and disclose provider data retention before enabling.
# -----------------------------------------------------------
AI_NPC_VISION_PROVIDER=
AI_NPC_VISION_KEY=
AI_NPC_VISION_ENDPOINT=
AI_NPC_VISION_MODEL=
AI_NPC_VISION_TIMEOUT_MS=8000
AI_NPC_VISION_MAX_OUTPUT_TOKENS=120
AI_NPC_VISION_REASONING_EFFORT=
AI_NPC_VISION_REASONING_FORMAT=
AI_NPC_VISION_KEEP_ALIVE=30m
# Optional vision failover (transient errors only).
AI_NPC_VISION_FALLBACK_PROVIDER=
AI_NPC_VISION_FALLBACK_KEY=
AI_NPC_VISION_FALLBACK_ENDPOINT=
AI_NPC_VISION_FALLBACK_MODEL=
AI_NPC_VISION_FALLBACK_TIMEOUT_MS=8000
AI_NPC_VISION_FALLBACK_MAX_OUTPUT_TOKENS=120
AI_NPC_VISION_FALLBACK_REASONING_EFFORT=
AI_NPC_VISION_FALLBACK_REASONING_FORMAT=
AI_NPC_VISION_FALLBACK_KEEP_ALIVE=30m

# -----------------------------------------------------------
# STT (Speech-to-text) provider — optional
# Leave blank to use keyboard text input only.
# -----------------------------------------------------------
AI_NPC_STT_PROVIDER=
AI_NPC_STT_KEY=
AI_NPC_STT_ENDPOINT=
AI_NPC_STT_MODEL=
