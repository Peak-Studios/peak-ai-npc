# High-quality hosted text setup: Claude Sonnet 4.
# Copy this file to ../.env and replace all REPLACE_* values.
AI_NPC_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_SECRET_AS_SERVER_CFG
AI_NPC_PUBLIC_BASE_URL=http://127.0.0.1:8787
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_DATABASE_PASSWORD

AI_NPC_PROVIDER=anthropic
AI_NPC_PROVIDER_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
AI_NPC_PROVIDER_ENDPOINT=https://api.anthropic.com/v1
AI_NPC_PROVIDER_MODEL=claude-sonnet-5
AI_NPC_PROVIDER_TOOL_MODE=auto

AI_NPC_FALLBACK_PROVIDER=ollama
AI_NPC_FALLBACK_KEY=
AI_NPC_FALLBACK_ENDPOINT=http://127.0.0.1:11434/v1
AI_NPC_FALLBACK_MODEL=qwen3:8b

AI_NPC_TTS_PROVIDER=
AI_NPC_TTS_KEY=
AI_NPC_VISION_PROVIDER=
AI_NPC_VISION_KEY=
AI_NPC_STT_PROVIDER=
AI_NPC_STT_KEY=
