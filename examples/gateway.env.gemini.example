# Recommended hosted text setup: Gemini 3.6 Flash (stable, low-latency).
# Copy this file to ../.env and replace all REPLACE_* values. Never commit .env.
AI_NPC_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_SECRET_AS_SERVER_CFG
AI_NPC_PUBLIC_BASE_URL=http://127.0.0.1:8787
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_DATABASE_PASSWORD

AI_NPC_PROVIDER=gemini
AI_NPC_PROVIDER_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_API_KEY
AI_NPC_PROVIDER_ENDPOINT=https://generativelanguage.googleapis.com
AI_NPC_PROVIDER_MODEL=gemini-3.6-flash
AI_NPC_PROVIDER_TOOL_MODE=auto

# Optional local failover when the hosted provider is unavailable.
AI_NPC_FALLBACK_PROVIDER=ollama
AI_NPC_FALLBACK_KEY=
AI_NPC_FALLBACK_ENDPOINT=http://127.0.0.1:11434/v1
AI_NPC_FALLBACK_MODEL=qwen3:8b

# These capability adapters are optional and currently expect an
# OpenAI-compatible implementation when enabled.
AI_NPC_TTS_PROVIDER=
AI_NPC_TTS_KEY=
AI_NPC_VISION_PROVIDER=
AI_NPC_VISION_KEY=
AI_NPC_STT_PROVIDER=
AI_NPC_STT_KEY=
