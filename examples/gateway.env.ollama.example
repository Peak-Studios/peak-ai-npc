# Recommended local/open-weight setup: Qwen3 8B.
# Before starting the gateway: ollama pull qwen3:8b
# Copy this file to ../.env and replace the shared secret/password placeholders.
AI_NPC_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_SECRET_AS_SERVER_CFG
AI_NPC_PUBLIC_BASE_URL=http://127.0.0.1:8787
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_DATABASE_PASSWORD

AI_NPC_PROVIDER=ollama
AI_NPC_PROVIDER_KEY=
AI_NPC_PROVIDER_ENDPOINT=http://127.0.0.1:11434/v1
AI_NPC_PROVIDER_MODEL=qwen3:8b
AI_NPC_PROVIDER_TOOL_MODE=auto

# No hosted fallback by default. You can add one later.
AI_NPC_FALLBACK_PROVIDER=
AI_NPC_FALLBACK_KEY=
AI_NPC_FALLBACK_ENDPOINT=
AI_NPC_FALLBACK_MODEL=

AI_NPC_TTS_PROVIDER=
AI_NPC_TTS_KEY=
AI_NPC_VISION_PROVIDER=
AI_NPC_VISION_KEY=
AI_NPC_STT_PROVIDER=
AI_NPC_STT_KEY=
